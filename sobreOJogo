    <!-- Script auxiliar para localizar automaticamente as imagens nas pastas comuns do repositório -->
    <script>
        function tryNextImage(img) {
            const list = (img.dataset.fallbacks || '').split(',').filter(Boolean);
            const idx = parseInt(img.dataset.attempt || '0', 10);
            if (idx < list.length) {
                img.dataset.attempt = idx + 1;
                img.src = list[idx];
            } else {
                img.style.display = 'none';
            }
        }
    </script>

