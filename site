  <style>
    /* =====================================================================
       ESTILOS GLOBAIS & IDENTIDADE VISUAL VICE CITY / LEONIDA
       ===================================================================== */
    :root {
      --bg-dark: #0d0618;
      --bg-card: #160922;
      --neon-pink: #ff2a85;
      --sunset-coral: #ff6b9d;
      --sunset-orange: #ff9e00;
      --vice-purple: #5a189a;
      --electric-cyan: #00e5ff;
      --vice-gold: #ffd166;
      --gradient-vice: linear-gradient(135deg, #ff2a85 0%, #ff9e00 50%, #5a189a 100%);
      --gradient-title: linear-gradient(90deg, #ff6b9d, #ffd166, #00e5ff);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background-color: #0d0618;
      color: #ffffff;
      font-family: 'Inter', sans-serif;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Controle de exibição das 4 páginas conectadas */
    .spa-page {
      display: none;
      animation: pageFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .spa-page.active-page {
      display: block;
    }

    @keyframes pageFadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Glassmorphism & Efeitos Néon */
    .glass-panel {
      background: rgba(22, 9, 38, 0.78);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }

    .neon-pink-glow {
      box-shadow: 0 0 22px rgba(255, 42, 133, 0.42), inset 0 0 12px rgba(255, 42, 133, 0.18);
    }

    .neon-cyan-glow {
      box-shadow: 0 0 20px rgba(0, 229, 255, 0.4), inset 0 0 10px rgba(0, 229, 255, 0.2);
    }

    .neon-gold-glow {
      box-shadow: 0 0 24px rgba(255, 209, 102, 0.35), inset 0 0 10px rgba(255, 209, 102, 0.15);
    }

    .text-gradient-vice {
      background: linear-gradient(90deg, #ff6b35 0%, #ff2a85 50%, #00e5ff 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .text-gradient-gold {
      background: linear-gradient(135deg, #fff3b0 0%, #ffd166 55%, #ff2a85 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .btn-vice-primary {
      background: linear-gradient(90deg, #ff2a85 0%, #ff6b35 100%);
      color: #ffffff;
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .btn-vice-primary:hover {
      transform: translateY(-2px) scale(1.015);
      box-shadow: 0 10px 30px rgba(255, 42, 133, 0.6);
    }

    .btn-vice-gold {
      background: linear-gradient(90deg, #ff2a85 0%, #ffd166 100%);
      color: #0d0618;
      transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    .btn-vice-gold:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 10px 30px rgba(255, 209, 102, 0.45);
    }

    /* =====================================================================
       ESTILOS ESPECÍFICOS — PÁGINA 01: INÍCIO
       ===================================================================== */
    .home-hero-bg {
      background:
        radial-gradient(circle at 85% 20%, rgba(255, 208, 0, 0.32), transparent 42%),
        radial-gradient(circle at 15% 80%, rgba(0, 229, 255, 0.22), transparent 45%),
        linear-gradient(135deg, #24073e 0%, #6d105e 48%, #c92a58 82%, #ff6b35 100%);
    }

    /* =====================================================================
       ESTILOS ESPECÍFICOS — PÁGINA 02: LOJA
       ===================================================================== */
    .vice-hero-bg {
      background:
        radial-gradient(circle at 75% 25%, rgba(255, 107, 53, 0.45) 0%, rgba(255, 42, 133, 0.35) 35%, rgba(59, 13, 84, 0.7) 70%, #0d0618 100%),
        linear-gradient(180deg, #240738 0%, #3b0d54 45%, #0d0618 100%);
    }

    .retro-grid {
      background-size: 40px 40px;
      background-image:
        linear-gradient(to right, rgba(255, 42, 133, 0.08) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 229, 255, 0.08) 1px, transparent 1px);
    }

    @keyframes modalPop {
      0% { opacity: 0; transform: scale(0.92) translateY(15px); }
      100% { opacity: 1; transform: scale(1) translateY(0); }
    }

    .animate-modal {
      animation: modalPop 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* =====================================================================
       ESTILOS ESPECÍFICOS — PÁGINA 03: MÍDIA & GALERIA
       ===================================================================== */
    .gallery-ambient {
      background-image:
        radial-gradient(circle at 15% 15%, rgba(255, 42, 133, 0.16), transparent 40%),
        radial-gradient(circle at 85% 30%, rgba(0, 229, 255, 0.14), transparent 40%),
        radial-gradient(circle at 50% 85%, rgba(90, 24, 154, 0.25), transparent 50%);
    }

    .btn-control {
      background: rgba(255, 255, 255, 0.06);
      color: #c7b8d6;
      border: 1px solid rgba(255, 255, 255, 0.14);
      padding: 0.55rem 1.05rem;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .btn-control:hover {
      border-color: #ff6b9d;
      color: #ffffff;
    }

    .btn-control.active {
      background: var(--gradient-vice);
      color: #ffffff;
      border-color: transparent;
      box-shadow: 0 4px 16px rgba(255, 42, 133, 0.4);
    }

    .media-card {
      position: relative;
      border-radius: 16px;
      overflow: hidden;
      background: #160922;
      border: 1px solid rgba(255, 255, 255, 0.12);
      cursor: pointer;
      transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
    }

    .media-card:hover {
      transform: translateY(-6px);
      border-color: #ff2a85;
      box-shadow: 0 15px 35px rgba(255, 42, 133, 0.3);
    }

    .media-card.featured {
      grid-column: 1 / -1;
    }

    .media-thumb-box {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #12061c;
    }

    .media-card.featured .media-thumb-box {
      aspect-ratio: 21 / 9;
    }

    .media-thumb-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.5s ease;
      display: block;
    }

    .media-card:hover .media-thumb-box img {
      transform: scale(1.06);
    }

    .zoom-badge {
      position: absolute;
      top: 12px;
      right: 12px;
      background: rgba(9, 4, 14, 0.85);
      color: #00e5ff;
      border: 1px solid rgba(0, 229, 255, 0.5);
      padding: 0.38rem 0.75rem;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 700;
      opacity: 0;
      transform: translateY(-5px);
      transition: all 0.25s ease;
    }

    .media-card:hover .zoom-badge {
      opacity: 1;
      transform: translateY(0);
    }

    .c-thumb {
      width: 115px;
      height: 66px;
      border-radius: 8px;
      overflow: hidden;
      border: 2px solid transparent;
      opacity: 0.55;
      cursor: pointer;
      flex-shrink: 0;
      transition: all 0.2s ease;
    }

    .c-thumb.active, .c-thumb:hover {
      opacity: 1;
      border-color: #00e5ff;
      transform: scale(1.04);
    }

    /* Lightbox */
    .lightbox {
      position: fixed;
      inset: 0;
      background: rgba(5, 2, 10, 0.96);
      backdrop-filter: blur(12px);
      z-index: 999;
      display: none;
      flex-direction: column;
      justify-content: space-between;
      padding: 1.25rem 1.5rem;
    }

    .lightbox.open {
      display: flex;
    }

    .lb-viewport img {
      max-width: 90%;
      max-height: 70vh;
      border-radius: 12px;
      box-shadow: 0 0 50px rgba(255, 42, 133, 0.35);
      transition: transform 0.3s ease;
      cursor: zoom-in;
    }

    .lb-viewport img.zoomed {
      transform: scale(1.55);
      cursor: zoom-out;
    }

    @media (max-width: 768px) {
      .media-card.featured .media-thumb-box {
        aspect-ratio: 16 / 9;
      }
      .lb-viewport img.zoomed {
        transform: scale(1.3);
      }
    }

    /* =====================================================================
       ESTILOS ESPECÍFICOS — PÁGINA 04: SOBRE O JOGO
       ===================================================================== */
    .leonida-banner-bg {
      background-image:
        linear-gradient(180deg, rgba(13, 6, 24, 0.65) 0%, rgba(59, 13, 84, 0.55) 45%, #0d0618 100%),
        radial-gradient(circle at 50% 35%, rgba(255, 209, 102, 0.35) 0%, rgba(255, 42, 133, 0.45) 45%, rgba(59, 13, 84, 0.85) 100%),
        url('https://images.unsplash.com/photo-1514214246283-d427a95c5d2f?auto=format&fit=crop&w=1920&q=80');
      background-size: cover;
      background-position: center 40%;
    }
  </style>
</head>
<body class="antialiased selection:bg-vice-pink selection:text-white">

