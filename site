  <!-- =====================================================================
       SCRIPT UNIFICADO: NAVEGAÇÃO ENTRE AS 4 PÁGINAS + LOJA + GALERIA
       ===================================================================== -->
  <script>
    /* ---------------------------------------------------------------------
       1. SISTEMA DE NAVEGAÇÃO ENTRE AS 4 PÁGINAS (SPA)
       --------------------------------------------------------------------- */
    const PAGES = ['inicio', 'loja', 'galeria', 'sobre'];

    function navigateTo(pageId, updateHash = true) {
      if (!PAGES.includes(pageId)) pageId = 'inicio';

      PAGES.forEach(id => {
        const section = document.getElementById(`page-${id}`);
        if (section) {
          section.classList.toggle('active-page', id === pageId);
        }
      });

      document.querySelectorAll('.nav-link').forEach(btn => {
        const isCurrent = btn.getAttribute('data-nav') === pageId;
        if (isCurrent) {
          btn.className = 'nav-link px-3.5 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer whitespace-nowrap bg-vice-pink/25 text-white border border-vice-pink shadow-[0_0_15px_rgba(255,42,133,0.4)]';
        } else {
          btn.className = 'nav-link px-3.5 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer whitespace-nowrap text-gray-300 hover:text-white border border-transparent hover:border-white/20';
        }
      });

      if (updateHash && window.location.hash !== `#${pageId}`) {
        history.replaceState(null, '', `#${pageId}`);
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function goToTrailer() {
      navigateTo('galeria');
      setTimeout(() => {
        const trailerBox = document.getElementById('trailer-oficial-box');
        if (trailerBox) {
          trailerBox.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }, 60);
    }

    // Fallback inteligente entre variações de caminho no GitHub
    function tryNextImage(img) {
      const list = (img.dataset.fallbacks || '').split(',').filter(Boolean);
      const idx = parseInt(img.dataset.attempt || '0', 10);
      if (idx < list.length) {
        img.dataset.attempt = idx + 1;
        img.src = list[idx];
      }
    }

    /* ---------------------------------------------------------------------
       2. LÓGICA DA PÁGINA 02: LOJA & PRÉ-VENDA
       --------------------------------------------------------------------- */
    const EDITIONS_DATA = {
      standard: {
        id: 'standard',
        name: 'GTA VI - Edição Standard',
        shortName: 'Edição Standard',
        price: 349.90,
        items: [
          'Jogo Base Grand Theft Auto VI',
          'Veículo exclusivo Pegassi Leonida',
          'GTA$ 500.000 no modo Online'
        ]
      },
      deluxe: {
        id: 'deluxe',
        name: 'GTA VI - Edição Deluxe (Vice City)',
        shortName: 'Edição Deluxe (Vice City)',
        price: 449.90,
        items: [
          'Jogo Base Grand Theft Auto VI',
          '3 dias de acesso antecipado',
          'Pacote de Roupas Vice Neon & Arsenal Dourado',
          'GTA$ 1.500.000 no modo Online'
        ]
      },
      collector: {
        id: 'collector',
        name: 'GTA VI - Colecionador (Leonida Kingpin)',
        shortName: 'Colecionador (Leonida Kingpin)',
        price: 599.90,
        items: [
          'Tudo da Edição Deluxe incluso',
          'Mapa Físico & Digital de Leonida',
          'Steelbook Exclusivo + Trilha Sonora Oficial',
          'GTA$ 3.000.000 + Mansão inicial no Online'
        ]
      }
    };

    const storeState = {
      platform: 'PlayStation 5',
      editionId: 'deluxe',
      payment: 'PIX (Aprovação Imediata)',
      paymentShort: 'PIX',
      isProcessing: false
    };

    function formatCurrencyBRL(value) {
      return value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    function updateOrderSummary() {
      const edition = EDITIONS_DATA[storeState.editionId];
      if (!edition) return;

      document.getElementById('summary-platform').textContent = storeState.platform;
      document.getElementById('summary-edition-name').textContent = edition.name;

      const formattedPrice = formatCurrencyBRL(edition.price);
      document.getElementById('summary-subtotal').textContent = formattedPrice;
      document.getElementById('summary-total').textContent = formattedPrice;

      const installmentEl = document.getElementById('summary-installments');
      if (storeState.paymentShort === 'Cartão de Crédito') {
        const parcela = formatCurrencyBRL(edition.price / 12);
        installmentEl.textContent = `ou até 12x de ${parcela} sem juros`;
      } else if (storeState.paymentShort === 'PIX') {
        installmentEl.textContent = 'À vista via PIX (Liberação imediata)';
      } else {
        installmentEl.textContent = 'R$ 0,00 hoje • 1ª parcela em 60 dias';
      }

      const itemsListEl = document.getElementById('summary-items-list');
      itemsListEl.innerHTML = edition.items.map(item => `
        <li class="flex items-center gap-2">
          <span class="text-vice-pink font-bold">•</span>
          <span>${item}</span>
        </li>
      `).join('');
    }

    function initStore() {
      const platformButtons = document.querySelectorAll('.platform-btn');
      platformButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          platformButtons.forEach(b => {
            b.classList.remove('border-vice-cyan', 'neon-cyan-glow');
            b.classList.add('border-white/10');
            const iconBox = b.querySelector('div');
            iconBox.classList.remove('bg-vice-cyan/20', 'text-vice-cyan');
            iconBox.classList.add('bg-white/10', 'text-gray-300');
            b.querySelector('.active-badge').classList.add('hidden');
          });

          btn.classList.remove('border-white/10');
          btn.classList.add('border-vice-cyan', 'neon-cyan-glow');
          const activeIconBox = btn.querySelector('div');
          activeIconBox.classList.remove('bg-white/10', 'text-gray-300');
          activeIconBox.classList.add('bg-vice-cyan/20', 'text-vice-cyan');
          btn.querySelector('.active-badge').classList.remove('hidden');

          storeState.platform = btn.getAttribute('data-platform');
          updateOrderSummary();
        });
      });

      const editionCards = document.querySelectorAll('.edition-card');
      editionCards.forEach(card => {
        card.addEventListener('click', () => {
          const selectedId = card.getAttribute('data-edition-id');
          storeState.editionId = selectedId;

          editionCards.forEach(c => {
            const cId = c.getAttribute('data-edition-id');
            const isSelected = cId === selectedId;
            const radioOuter = c.querySelector('.edition-radio');
            const radioInner = radioOuter.querySelector('div');
            const actionBtn = c.querySelector('.select-edition-btn');

            c.classList.remove('border-vice-pink', 'neon-pink-glow', 'border-vice-gold', 'neon-gold-glow');
            c.classList.add('border-white/10');
            radioOuter.classList.remove('border-vice-pink', 'border-vice-gold');
            radioOuter.classList.add('border-gray-500');
            radioInner.classList.add('hidden');
            actionBtn.className = 'select-edition-btn w-full py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-wider transition';

            if (isSelected) {
              c.classList.remove('border-white/10');
              if (cId === 'collector') {
                c.classList.add('border-vice-gold', 'neon-gold-glow');
                radioOuter.classList.replace('border-gray-500', 'border-vice-gold');
                radioInner.classList.remove('hidden');
                actionBtn.className = 'select-edition-btn w-full py-2.5 rounded-xl bg-vice-gold text-[#0d0618] font-black text-xs uppercase tracking-wider transition shadow-lg';
              } else {
                c.classList.add('border-vice-pink', 'neon-pink-glow');
                radioOuter.classList.replace('border-gray-500', 'border-vice-pink');
                radioInner.classList.remove('hidden');
                actionBtn.className = 'select-edition-btn w-full py-2.5 rounded-xl bg-vice-pink text-white font-bold text-xs uppercase tracking-wider transition shadow-lg';
              }
              actionBtn.textContent = 'Selecionada';
            } else {
              if (cId === 'standard') actionBtn.textContent = 'Selecionar Standard';
              if (cId === 'deluxe') actionBtn.textContent = 'Selecionar Deluxe';
              if (cId === 'collector') actionBtn.textContent = 'Selecionar Kingpin';
            }
          });

          updateOrderSummary();
        });
      });

      const payButtons = document.querySelectorAll('.payment-btn');
      payButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          payButtons.forEach(b => {
            b.classList.remove('border-vice-cyan', 'bg-vice-cyan/15', 'text-white');
            b.classList.add('border-white/10', 'bg-white/5', 'text-gray-300');
          });
          btn.classList.remove('border-white/10', 'bg-white/5', 'text-gray-300');
          btn.classList.add('border-vice-cyan', 'bg-vice-cyan/15', 'text-white');

          storeState.payment = btn.getAttribute('data-payment');
          storeState.paymentShort = btn.getAttribute('data-payment-short');
          updateOrderSummary();
        });
      });

      const btnCheckout = document.getElementById('btn-checkout');
      const btnCheckoutText = document.getElementById('btn-checkout-text');
      const modal = document.getElementById('confirmation-modal');
      const btnCloseX = document.getElementById('btn-close-modal-x');
      const btnNewSim = document.getElementById('btn-new-simulation');
      const btnCopyCode = document.getElementById('btn-copy-code');
      const copyFeedback = document.getElementById('copy-feedback');

      btnCheckout.addEventListener('click', () => {
        if (storeState.isProcessing) return;
        storeState.isProcessing = true;

        btnCheckout.classList.add('opacity-85', 'cursor-wait');
        btnCheckoutText.innerHTML = `
          <svg class="animate-spin inline-block w-5 h-5 mr-2 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          PROCESSANDO RESERVA EM LEONIDA...
        `;

        setTimeout(() => {
          const edition = EDITIONS_DATA[storeState.editionId];
          const randomOrderNum = Math.floor(10000 + Math.random() * 90000);
          const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
          const block = (len) => Array.from({ length: len }, () => chars[Math.floor(Math.random() * chars.length)]).join('');

          document.getElementById('modal-order-id').textContent = `#GTA6-${randomOrderNum}`;
          document.getElementById('modal-edition').textContent = edition.shortName;
          document.getElementById('modal-platform').textContent = storeState.platform;
          document.getElementById('modal-payment').textContent = storeState.paymentShort;
          document.getElementById('modal-total').textContent = formatCurrencyBRL(edition.price);
          document.getElementById('modal-redeem-code').textContent = `VICE-${block(4)}-LEON-${block(4)}`;

          copyFeedback.classList.add('opacity-0');
          btnCopyCode.textContent = 'Copiar';

          modal.classList.remove('hidden');
          modal.classList.add('flex');

          storeState.isProcessing = false;
          btnCheckout.classList.remove('opacity-85', 'cursor-wait');
          btnCheckoutText.textContent = 'COMPRAR AGORA • RESERVAR PRÉ-VENDA';
        }, 850);
      });

      const closeModal = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      };

      btnCloseX.addEventListener('click', closeModal);
      btnNewSim.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      btnCopyCode.addEventListener('click', () => {
        const codeText = document.getElementById('modal-redeem-code').textContent.trim();
        const tempInput = document.createElement('textarea');
        tempInput.value = codeText;
        document.body.appendChild(tempInput);
        tempInput.select();
        try {
          document.execCommand('copy');
          btnCopyCode.textContent = 'Copiado!';
          copyFeedback.classList.remove('opacity-0');
        } catch (err) {
          console.error('Erro ao copiar código:', err);
        }
        document.body.removeChild(tempInput);
      });

      updateOrderSummary();
    }

    /* ---------------------------------------------------------------------
       3. LÓGICA DA PÁGINA 03: MÍDIA & GALERIA
       (Usando exatamente os 5 arquivos enviados: capa.jpg, lucia.jpg, praia.jpg, barco.webp, lama.webp)
       --------------------------------------------------------------------- */
    const mediaItems = [
      {
        src: "capa.jpg",
        category: "arte",
        categoryLabel: "Arte Oficial Principal",
        title: "Lucia Caminos & Jason Duval — Vice City",
        desc: "Arte promocional oficial destacando a dupla protagonista nas docas ensolaradas de Vice City com helicóptero e lancha policial ao fundo.",
        featured: true
      },
      {
        src: "lucia.jpg",
        category: "personagens",
        categoryLabel: "Personagens",
        title: "Lucia — Treinamento Intenso",
        desc: "Lucia aprimora os seus golpes no saco de pancadas antes de encarar os desafios mais perigosos do submundo de Leonida.",
        featured: false
      },
      {
        src: "praia.jpg",
        category: "mundo",
        categoryLabel: "Vice City & Leonida",
        title: "Vice Beach — O Coração de Vice City",
        desc: "Areias movimentadas, motas de água, helicópteros a sobrevoar arranha-céus Art Déco e a energia vibrante da costa de Leonida.",
        featured: false
      },
      {
        src: "barco.webp",
        category: "mundo",
        categoryLabel: "Vice City & Leonida",
        title: "Arquipélago de Leonida Keys",
        desc: "Navegação em águas cristalinas rumo às ilhas tropicais do sul do estado sob nuvens carregadas no horizonte.",
        featured: false
      },
      {
        src: "lama.webp",
        category: "mundo",
        categoryLabel: "Cultura de Leonida",
        title: "Thrillbilly Mud Club",
        desc: "A lama voa alto nos eventos todo-o-terreno com camiões monstruosos e festas radicais no interior de Leonida.",
        featured: false
      }
    ];

    let activeFilter = "todos";
    let filteredItems = [...mediaItems];
    let currentLightboxIndex = 0;
    let currentCarouselIndex = 0;
    let isZoomed = false;

    function renderGrid() {
      const galleryGrid = document.getElementById("galleryGrid");
      galleryGrid.innerHTML = "";
      filteredItems.forEach((item, index) => {
        const card = document.createElement("article");
        card.className = `media-card ${item.featured && activeFilter === "todos" ? "featured" : ""}`;
        card.onclick = () => openLightbox(index);

        card.innerHTML = `
          <div class="media-thumb-box">
            <img src="${item.src}" alt="${item.title}" loading="lazy" />
            <span class="zoom-badge">🔍 Ampliar Imagem</span>
          </div>
          <div class="p-5">
            <span class="text-xs font-extrabold uppercase tracking-widest text-vice-orange block mb-1">${item.categoryLabel}</span>
            <h3 class="font-display text-lg font-extrabold text-white mb-1.5">${item.title}</h3>
            <p class="text-sm text-gray-300 leading-relaxed">${item.desc}</p>
          </div>
        `;
        galleryGrid.appendChild(card);
      });
    }

    function renderCarousel() {
      if (currentCarouselIndex >= filteredItems.length) currentCarouselIndex = 0;
      const item = filteredItems[currentCarouselIndex];

      const cImg = document.getElementById("carouselImg");
      cImg.src = item.src;
      cImg.alt = item.title;

      document.getElementById("carouselCat").textContent = item.categoryLabel;
      document.getElementById("carouselTitle").textContent = item.title;
      document.getElementById("carouselDesc").textContent = item.desc;

      const thumbsContainer = document.getElementById("carouselThumbs");
      thumbsContainer.innerHTML = "";
      filteredItems.forEach((thumbItem, idx) => {
        const thumb = document.createElement("div");
        thumb.className = `c-thumb ${idx === currentCarouselIndex ? "active" : ""}`;
        thumb.onclick = () => {
          currentCarouselIndex = idx;
          renderCarousel();
        };
        thumb.innerHTML = `<img src="${thumbItem.src}" alt="${thumbItem.title}" class="w-full h-full object-cover" />`;
        thumbsContainer.appendChild(thumb);
      });
    }

    function changeSlide(step) {
      currentCarouselIndex = (currentCarouselIndex + step + filteredItems.length) % filteredItems.length;
      renderCarousel();
    }

    function setViewMode(mode) {
      const galleryGrid = document.getElementById("galleryGrid");
      const carouselView = document.getElementById("carouselView");
      const btnGrid = document.getElementById("btnGrid");
      const btnCarousel = document.getElementById("btnCarousel");

      if (mode === "grid") {
        galleryGrid.style.display = "grid";
        carouselView.classList.add("hidden");
        btnGrid.classList.add("active");
        btnCarousel.classList.remove("active");
      } else {
        galleryGrid.style.display = "none";
        carouselView.classList.remove("hidden");
        btnCarousel.classList.add("active");
        btnGrid.classList.remove("active");
        renderCarousel();
      }
    }

    function initGallery() {
      document.querySelectorAll("[data-filter]").forEach(btn => {
        btn.addEventListener("click", () => {
          document.querySelectorAll("[data-filter]").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");

          activeFilter = btn.dataset.filter;
          filteredItems = activeFilter === "todos"
            ? [...mediaItems]
            : mediaItems.filter(item => item.category === activeFilter);

          currentCarouselIndex = 0;
          renderGrid();
          renderCarousel();
        });
      });

      renderGrid();
    }

    function openLightbox(index) {
      currentLightboxIndex = index;
      isZoomed = false;
      updateLightbox();
      document.getElementById("lightbox").classList.add("open");
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      document.getElementById("lightbox").classList.remove("open");
      document.body.style.overflow = "";
    }

    function navigateLightbox(step) {
      currentLightboxIndex = (currentLightboxIndex + step + filteredItems.length) % filteredItems.length;
      isZoomed = false;
      updateLightbox();
    }

    function toggleZoom() {
      isZoomed = !isZoomed;
      const img = document.getElementById("lbImage");
      const btn = document.getElementById("btnZoomToggle");
      img.classList.toggle("zoomed", isZoomed);
      btn.textContent = isZoomed ? "Reduzir (Zoom -)" : "Ampliar (Zoom +)";
    }

    function updateLightbox() {
      const item = filteredItems[currentLightboxIndex];
      const img = document.getElementById("lbImage");
      img.classList.remove("zoomed");
      img.src = item.src;
      img.alt = item.title;

      document.getElementById("btnZoomToggle").textContent = "Ampliar (Zoom +)";
      document.getElementById("lbCounter").textContent = `${currentLightboxIndex + 1} / ${filteredItems.length}`;
      document.getElementById("lbTitle").textContent = item.title;
      document.getElementById("lbDesc").textContent = item.desc;
    }

    document.addEventListener("keydown", (e) => {
      const lb = document.getElementById("lightbox");
      if (!lb.classList.contains("open")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowRight") navigateLightbox(1);
      if (e.key === "ArrowLeft") navigateLightbox(-1);
    });

    /* ---------------------------------------------------------------------
       INICIALIZAÇÃO GERAL DO PORTAL UNIFICADO
       --------------------------------------------------------------------- */
    document.addEventListener("DOMContentLoaded", () => {
      initStore();
      initGallery();

      const initialHash = window.location.hash.replace('#', '');
      if (PAGES.includes(initialHash)) {
        navigateTo(initialHash, false);
      } else {
        navigateTo('inicio', false);
      }
    });
  </script>
</body>
</html>
