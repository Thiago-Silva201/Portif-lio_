    <!-- LÓGICA JAVASCRIPT INTERATIVA -->
    <script>
        // Catálogo de Edições Disponíveis
        const EDITIONS_DATA = {
            standard: {
                id: 'standard',
                name: 'GTA VI - Edição Standard',
                shortName: 'Edição Standard',
                price: 349.90,
                items: [
                    'Jogo Base Grand Theft Auto VI',
                    'Veículo exclusivo Pegassi Leonida',
                    'GTA$ 500.000 no modo Online'
                ]
            },
            deluxe: {
                id: 'deluxe',
                name: 'GTA VI - Edição Deluxe (Vice City)',
                shortName: 'Edição Deluxe (Vice City)',
                price: 449.90,
                items: [
                    'Jogo Base Grand Theft Auto VI',
                    '3 dias de acesso antecipado',
                    'Pacote de Roupas Vice Neon & Arsenal Dourado',
                    'GTA$ 1.500.000 no modo Online'
                ]
            },
            collector: {
                id: 'collector',
                name: 'GTA VI - Colecionador (Leonida Kingpin)',
                shortName: 'Colecionador (Leonida Kingpin)',
                price: 599.90,
                items: [
                    'Tudo da Edição Deluxe incluso',
                    'Mapa Físico & Digital de Leonida',
                    'Steelbook Exclusivo + Trilha Sonora Oficial',
                    'GTA$ 3.000.000 + Mansão inicial no Online'
                ]
            }
        };

        // Estado atual da aplicação
        const appState = {
            platform: 'PlayStation 5',
            editionId: 'deluxe',
            payment: 'PIX (Aprovação Imediata)',
            paymentShort: 'PIX',
            isProcessing: false
        };

        // Formata valores numéricos para Real Brasileiro (BRL)
        function formatCurrencyBRL(value) {
            return value.toLocaleString('pt-BR', {
                style: 'currency',
                currency: 'BRL'
            });
        }

        // Atualiza todo o Resumo do Pedido na tela
        function updateOrderSummary() {
            const edition = EDITIONS_DATA[appState.editionId];
            if (!edition) return;

            // Atualiza textos principais
            document.getElementById('summary-platform').textContent = appState.platform;
            document.getElementById('summary-edition-name').textContent = edition.name;
            
            const formattedPrice = formatCurrencyBRL(edition.price);
            document.getElementById('summary-subtotal').textContent = formattedPrice;
            document.getElementById('summary-total').textContent = formattedPrice;

            // Atualiza texto de condição de pagamento
            const installmentEl = document.getElementById('summary-installments');
            if (appState.paymentShort === 'Cartão de Crédito') {
                const parcela = formatCurrencyBRL(edition.price / 12);
                installmentEl.textContent = `ou até 12x de ${parcela} sem juros`;
            } else if (appState.paymentShort === 'PIX') {
                installmentEl.textContent = 'À vista via PIX (Liberação imediata)';
            } else {
                installmentEl.textContent = 'À vista no Boleto Bancário';
            }

            // Atualiza lista de itens inclusos
            const itemsListEl = document.getElementById('summary-items-list');
            itemsListEl.innerHTML = edition.items.map(item => `
                <li class="flex items-center gap-2">
                    <span class="text-vice-pink font-bold">•</span>
                    <span>${item}</span>
                </li>
            `).join('');
        }

        // Gerencia seleção de Plataforma
        function initPlatformSelector() {
            const buttons = document.querySelectorAll('.platform-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    // Remove destaque de todos
                    buttons.forEach(b => {
                        b.classList.remove('border-vice-cyan', 'neon-cyan-glow');
                        b.classList.add('border-white/10');
                        const iconBox = b.querySelector('div');
                        iconBox.classList.remove('bg-vice-cyan/20', 'text-vice-cyan');
                        iconBox.classList.add('bg-white/10', 'text-gray-300');
                        b.querySelector('.active-badge').classList.add('hidden');
                    });

                    // Ativa o clicado
                    btn.classList.remove('border-white/10');
                    btn.classList.add('border-vice-cyan', 'neon-cyan-glow');
                    const activeIconBox = btn.querySelector('div');
                    activeIconBox.classList.remove('bg-white/10', 'text-gray-300');
                    activeIconBox.classList.add('bg-vice-cyan/20', 'text-vice-cyan');
                    btn.querySelector('.active-badge').classList.remove('hidden');

                    appState.platform = btn.getAttribute('data-platform');
                    updateOrderSummary();
                });
            });
        }

        // Gerencia seleção de Edições
        function initEditionSelector() {
            const cards = document.querySelectorAll('.edition-card');
            cards.forEach(card => {
                card.addEventListener('click', () => {
                    const selectedId = card.getAttribute('data-edition-id');
                    appState.editionId = selectedId;

                    cards.forEach(c => {
                        const cId = c.getAttribute('data-edition-id');
                        const isSelected = cId === selectedId;
                        const radioOuter = c.querySelector('.edition-radio');
                        const radioInner = radioOuter.querySelector('div');
                        const actionBtn = c.querySelector('.select-edition-btn');

                        // Reset de estilos
                        c.classList.remove('border-vice-pink', 'neon-pink-glow', 'border-vice-gold', 'neon-gold-glow');
                        c.classList.add('border-white/10');
                        radioOuter.classList.remove('border-vice-pink', 'border-vice-gold');
                        radioOuter.classList.add('border-gray-500');
                        radioInner.classList.add('hidden');
                        actionBtn.className = 'select-edition-btn w-full py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-xs uppercase tracking-wider transition';

                        if (isSelected) {
                            c.classList.remove('border-white/10');
                            if (cId === 'collector') {
                                c.classList.add('border-vice-gold', 'neon-gold-glow');
                                radioOuter.classList.replace('border-gray-500', 'border-vice-gold');
                                radioInner.classList.remove('hidden');
                                actionBtn.className = 'select-edition-btn w-full py-2.5 rounded-xl bg-vice-gold text-[#0d0618] font-black text-xs uppercase tracking-wider transition shadow-lg';
                            } else {
                                c.classList.add('border-vice-pink', 'neon-pink-glow');
                                radioOuter.classList.replace('border-gray-500', 'border-vice-pink');
                                radioInner.classList.remove('hidden');
                                actionBtn.className = 'select-edition-btn w-full py-2.5 rounded-xl bg-vice-pink text-white font-bold text-xs uppercase tracking-wider transition shadow-lg';
                            }
                            actionBtn.textContent = 'Selecionada';
                        } else {
                            if (cId === 'standard') actionBtn.textContent = 'Selecionar Standard';
                            if (cId === 'deluxe') actionBtn.textContent = 'Selecionar Deluxe';
                            if (cId === 'collector') actionBtn.textContent = 'Selecionar Kingpin';
                        }
                    });

                    updateOrderSummary();
                });
            });
        }

        // Gerencia seleção de Forma de Pagamento
        function initPaymentSelector() {
            const payButtons = document.querySelectorAll('.payment-btn');
            payButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    payButtons.forEach(b => {
                        b.classList.remove('border-vice-cyan', 'bg-vice-cyan/15', 'text-white');
                        b.classList.add('border-white/10', 'bg-white/5', 'text-gray-300');
                    });

                    btn.classList.remove('border-white/10', 'bg-white/5', 'text-gray-300');
                    btn.classList.add('border-vice-cyan', 'bg-vice-cyan/15', 'text-white');

                    appState.payment = btn.getAttribute('data-payment');
                    appState.paymentShort = btn.getAttribute('data-payment-short');
                    updateOrderSummary();
                });
            });
        }

        // Gera código de pedido e chave de resgate fictícios
        function generateOrderDetails() {
            const randomOrderNum = Math.floor(10000 + Math.random() * 90000);
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
            const randomBlock = (len) => Array.from({ length: len }, () => chars[Math.floor(Math.random() * chars.length)]).join('');
            
            return {
                orderId: `#GTA6-${randomOrderNum}`,
                redeemCode: `VICE-${randomBlock(4)}-LEON-${randomBlock(4)}`
            };
        }

        // Lógica do Checkout e Modal de Confirmação
        function initCheckoutFlow() {
            const btnCheckout = document.getElementById('btn-checkout');
            const btnCheckoutText = document.getElementById('btn-checkout-text');
            const modal = document.getElementById('confirmation-modal');
            const btnCloseX = document.getElementById('btn-close-modal-x');
            const btnNewSim = document.getElementById('btn-new-simulation');
            const btnCopyCode = document.getElementById('btn-copy-code');
            const copyFeedback = document.getElementById('copy-feedback');

            btnCheckout.addEventListener('click', () => {
                if (appState.isProcessing) return;
                appState.isProcessing = true;

                // Estado de processamento no botão
                btnCheckout.classList.add('opacity-85', 'cursor-wait');
                btnCheckoutText.innerHTML = `
                    <svg class="animate-spin inline-block w-5 h-5 mr-2 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    PROCESSANDO RESERVA EM LEONIDA...
                `;

                // Simula tempo de resposta da loja oficial (900ms)
                setTimeout(() => {
                    const edition = EDITIONS_DATA[appState.editionId];
                    const generated = generateOrderDetails();

                    // Preenche dados do modal
                    document.getElementById('modal-order-id').textContent = generated.orderId;
                    document.getElementById('modal-edition').textContent = edition.shortName;
                    document.getElementById('modal-platform').textContent = appState.platform;
                    document.getElementById('modal-payment').textContent = appState.paymentShort;
                    document.getElementById('modal-total').textContent = formatCurrencyBRL(edition.price);
                    document.getElementById('modal-redeem-code').textContent = generated.redeemCode;

                    // Reseta feedback de cópia
                    copyFeedback.classList.add('opacity-0');
                    btnCopyCode.textContent = 'Copiar';

                    // Exibe modal
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');

                    // Restaura botão principal
                    appState.isProcessing = false;
                    btnCheckout.classList.remove('opacity-85', 'cursor-wait');
                    btnCheckoutText.textContent = 'COMPRAR AGORA • RESERVAR PRÉ-VENDA';
                }, 900);
            });

            // Função para fechar o modal
            const closeModal = () => {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            };

            btnCloseX.addEventListener('click', closeModal);
            btnNewSim.addEventListener('click', closeModal);

            // Fecha ao clicar fora do cartão do modal
            modal.addEventListener('click', (e) => {
                if (e.target === modal) closeModal();
            });

            // Copiar chave digital usando método compatível com iframes
            btnCopyCode.addEventListener('click', () => {
                const codeText = document.getElementById('modal-redeem-code').textContent.trim();
                const tempInput = document.createElement('textarea');
                tempInput.value = codeText;
                document.body.appendChild(tempInput);
                tempInput.select();
                try {
                    document.execCommand('copy');
                    btnCopyCode.textContent = 'Copiado!';
                    copyFeedback.classList.remove('opacity-0');
                } catch (err) {
                    console.error('Erro ao copiar código:', err);
                }
                document.body.removeChild(tempInput);
            });
        }

        // Inicialização geral após carregamento da página
        document.addEventListener('DOMContentLoaded', () => {
            initPlatformSelector();
            initEditionSelector();
            initPaymentSelector();
            initCheckoutFlow();
            updateOrderSummary();
        });
    </script>
</body>
</html>
