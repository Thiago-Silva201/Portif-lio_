            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .text-gradient-gold {
            background: linear-gradient(135deg, #fff3b0 0%, #ffd166 50%, #ff9f1c 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
