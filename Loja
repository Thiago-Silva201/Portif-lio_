        /* Efeitos de brilho néon */
        .neon-pink-glow {
            box-shadow: 0 0 20px rgba(255, 42, 133, 0.45), inset 0 0 12px rgba(255, 42, 133, 0.2);
        }

        .neon-cyan-glow {
            box-shadow: 0 0 20px rgba(0, 229, 255, 0.4), inset 0 0 10px rgba(0, 229, 255, 0.2);
        }

