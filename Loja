        /* Botão Principal Vibrante */
        .btn-vice-primary {
            background: linear-gradient(90deg, #ff2a85 0%, #ff6b35 100%);
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            position: relative;
            overflow: hidden;
